# Copy to .env and fill in. Never commit the real file.
#
# SHOPIFY_API_KEY and SHOPIFY_API_SECRET are injected by `shopify app dev`
# during local development, so they can stay blank here. They must be set on
# your host in production.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.onrender.com
SCOPES=read_products,write_products

# Postgres, two connections to the same database.
#
# DATABASE_URL  — POOLED (host contains "-pooler"). Used by the running app.
# DIRECT_URL    — UNPOOLED. Used only by Prisma Migrate, whose advisory locks
#                 and DDL do not survive a transaction-mode pooler.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# "0" in production. Anything else keeps Shopify billing in test mode, where
# subscriptions are approved but never actually charged.
SHOPIFY_BILLING_TEST=1
